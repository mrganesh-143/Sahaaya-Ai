# ============================================================
# SAHAAYA Backend – Environment Variables
# Copy this to .env and fill in your values.
# ============================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # NEVER expose in responses/logs

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- JWT ---
JWT_SECRET=your-very-long-random-secret-string-at-least-32-chars

# --- CORS ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,https://sahaaya.in

# --- App ---
ENVIRONMENT=development    # development | staging | production
